{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WorkloadCeiling",
      "Effect": "Allow",
      "Action": "*",
      "Resource": "*"
    },
    {
      "Sid": "NoIdentityChangesFromWorkloads",
      "Effect": "Deny",
      "Action": [
        "iam:*",
        "sts:AssumeRole",
        "sts:AssumeRoleWithWebIdentity",
        "sts:AssumeRoleWithSAML",
        "organizations:*",
        "account:*"
      ],
      "Resource": "*"
    }
  ]
}
