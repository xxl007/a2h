{
  // Typecheck config (editor, ESLint, `pnpm typecheck`). No emit: the contract
  // tests run under `node --test` (type stripping), the e2e under Playwright.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    // DOM for the callbacks Playwright runs in the page (page.evaluate).
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["src", "contract", "adversarial", "local", "e2e", "playwright.config.ts"]
}
