{
  "name": "@a2h/tests",
  "version": "0.0.0",
  "private": true,
  "description": "Playwright e2e, MCP contract tests, adversarial suite.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test --test-reporter=spec \"adversarial/*.local.test.ts\"",
    "contract": "node --test --test-reporter=spec \"contract/*.test.ts\"",
    "adversarial": "node --test --test-reporter=spec \"adversarial/*.live.test.ts\"",
    "e2e": "playwright test",
    "local-stage": "node local/stage.ts"
  },
  "devDependencies": {
    "@a2h/db": "workspace:*",
    "@a2h/protocol": "workspace:*",
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "@types/pg": "8.23.1",
    "undici": "7.30.1",
    "yaml": "2.9.0"
  }
}
