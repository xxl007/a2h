#!/usr/bin/env bash
# Stub of the aws CLI for tests/ci/*.test.sh. No network, no credentials.
# Implements only the calls .github/scripts/pr-schema.sh makes, keeping state
# in $STUB_DIR:
#   calls   one line per invocation: the full argument list (what `ps` would show)
#   rds     one line per Data API statement: database<TAB>resourceArn<TAB>secretArn<TAB>sql
#   secret  the current value of the per-PR secret (absent = no secret)
#   names   one line per secret operation: <operation> <secret id>
# STUB_MODE scripts failures; STUB_PASSWORD is what get-random-password returns;
# STUB_PSQL, if set, is a command that receives each statement on stdin and runs
# it against a real Postgres (tests/ci/pr-schema.pg.test.sh, db-migrate.test.sh).
#
# Data API transactions (db-migrate.sh): begin-transaction opens tx/<id>.sql;
# each execute-statement with a transactionId is checked by replaying the
# transaction so far plus the statement inside BEGIN ... ROLLBACK (so an error
# is reported by the call that caused it, and session state such as SET LOCAL
# ROLE or search_path carries across statements, as on one pinned connection),
# then appended; commit-transaction replays it all with COMMIT;
# rollback-transaction discards it. formatRecordsAs JSON wraps the statement in
# json_agg and returns formattedRecords ("[]" without STUB_PSQL).
#   tx     one line per transaction operation: begin|commit|rollback <id>
# STUB_TX_CHECK=commit skips the per-statement replay of statements that return
# no records (they are checked once, at commit): much faster, errors surface at
# commit instead of at the failing call. Default: each.
# STUB_MODE no-set-role: SET ROLE statements inside a transaction are accepted
# and dropped, as if the Data API did not keep the role (design D2 fallback).
set -uo pipefail
: "${STUB_DIR:?}"
mode=${STUB_MODE:-ok}
printf '%s\n' "$*" >>"$STUB_DIR/calls"

arg() { # arg <flag> <args...>: value following <flag>
  local flag=$1; shift
  while [ "$#" -gt 0 ]; do
    if [ "$1" = "$flag" ]; then printf '%s' "${2-}"; return 0; fi
    shift
  done
  return 1
}
from_file() { # file://path -> contents
  local ref=$1
  [ "${ref#file://}" != "$ref" ] || { echo "stub: expected file:// argument, got a literal" >&2; exit 255; }
  cat "${ref#file://}"
}
err() { echo "An error occurred ($1) when calling the $2 operation: $3" >&2; exit 254; }

case "${1-} ${2-}" in
  "ssm get-parameter")
    name=$(arg --name "$@")
    if [ "$mode" = "ssm-empty" ]; then echo "None"; exit 0; fi
    case "$name" in
      */aurora-cluster-arn) echo "arn:aws:rds:eu-west-3:000000000000:cluster:synthetic" ;;
      */aurora-secret-arn) echo "arn:aws:secretsmanager:eu-west-3:000000000000:secret:synthetic" ;;
      # The sign-in allow-list (.github/scripts/allowlist.sh): state in $STUB_DIR/allowlist, SecureString, so --with-decryption is required.
      */principal-allowlist)
        echo "get $name" >>"$STUB_DIR/ssm"
        case "$*" in *--with-decryption*) ;; *) echo "stub: SecureString read without --with-decryption" >&2; exit 255 ;; esac
        [ -f "$STUB_DIR/allowlist" ] || err ParameterNotFound GetParameter "Parameter $name not found."
        cat "$STUB_DIR/allowlist"; echo ;;
      *) err ParameterNotFound GetParameter "unexpected parameter $name" ;;
    esac
    exit 0 ;;

  "ssm put-parameter")
    name=$(arg --name "$@")
    echo "put $name" >>"$STUB_DIR/ssm"
    [ "$mode" = "ssm-put-denied" ] && err AccessDeniedException PutParameter "not authorized"
    case "$name" in */principal-allowlist) ;; *) err ValidationException PutParameter "unexpected parameter $name" ;; esac
    [ "$(arg --type "$@")" = "SecureString" ] || { echo "stub: allow-list written as $(arg --type "$@"), want SecureString" >&2; exit 255; }
    case "$*" in *--overwrite*) ;; *) [ -f "$STUB_DIR/allowlist" ] && err ParameterAlreadyExists PutParameter "exists" ;; esac
    value=$(arg --value "$@")
    [ -n "$value" ] || err ValidationException PutParameter "1 validation error detected: Value at 'value' failed to satisfy constraint: Member must have length greater than or equal to 1"
    printf '%s' "$value" >"$STUB_DIR/allowlist"
    echo '{"Version": 2, "Tier": "Standard"}'
    exit 0 ;;

  "secretsmanager get-secret-value")
    echo "get $(arg --secret-id "$@")" >>"$STUB_DIR/names"
    [ "$mode" = "secret-denied" ] && err AccessDeniedException GetSecretValue "not authorized"
    [ -f "$STUB_DIR/secret" ] || err ResourceNotFoundException GetSecretValue "Secrets Manager can't find the specified secret."
    cat "$STUB_DIR/secret"; echo
    exit 0 ;;

  "secretsmanager get-random-password")
    case "$*" in *--exclude-punctuation*) ;; *) echo "stub: punctuation not excluded" >&2; exit 255 ;; esac
    case "$*" in *"--password-length 32"*) ;; *) echo "stub: length is not 32" >&2; exit 255 ;; esac
    printf '%s\n' "${STUB_PASSWORD:?}"
    exit 0 ;;

  "secretsmanager create-secret")
    name=$(arg --name "$@")
    echo "create $name" >>"$STUB_DIR/names"
    value=$(from_file "$(arg --secret-string "$@")") || exit 255
    if [ "$mode" = "create-race" ]; then
      # Another run created it between our read and our create.
      printf '%s' "${STUB_RACE_SECRET:?}" >"$STUB_DIR/secret"
      err ResourceExistsException CreateSecret "The operation failed because the secret $name already exists."
    fi
    [ -f "$STUB_DIR/secret" ] && err ResourceExistsException CreateSecret "already exists"
    printf '%s' "$value" >"$STUB_DIR/secret"
    echo "{\"Name\": \"$name\"}"
    exit 0 ;;

  "secretsmanager delete-secret")
    echo "delete $(arg --secret-id "$@")" >>"$STUB_DIR/names"
    case "$*" in *--force-delete-without-recovery*) ;; *) echo "stub: delete with recovery window" >&2; exit 255 ;; esac
    [ "$mode" = "delete-denied" ] && err AccessDeniedException DeleteSecret "not authorized"
    [ -f "$STUB_DIR/secret" ] || err ResourceNotFoundException DeleteSecret "Secrets Manager can't find the specified secret."
    rm -f "$STUB_DIR/secret"
    echo '{}'
    exit 0 ;;

  "rds-data begin-transaction")
    n=$(($(cat "$STUB_DIR/tx_count" 2>/dev/null || echo 0) + 1)); echo "$n" >"$STUB_DIR/tx_count"
    id="tx-$n"
    mkdir -p "$STUB_DIR/tx"; : >"$STUB_DIR/tx/$id.sql"
    echo "begin $id" >>"$STUB_DIR/txlog"
    echo "{\"transactionId\": \"$id\"}"
    exit 0 ;;

  "rds-data commit-transaction" | "rds-data rollback-transaction")
    id=$(arg --transaction-id "$@")
    [ -f "$STUB_DIR/tx/$id.sql" ] || err BadRequestException "${2}" "Transaction $id is not found"
    op=${2%-transaction}
    echo "$op $id" >>"$STUB_DIR/txlog"
    if [ "$op" = commit ] && [ -n "${STUB_PSQL:-}" ]; then
      if ! res=$({ echo "BEGIN;"; cat "$STUB_DIR/tx/$id.sql"; echo "COMMIT;"; } | $STUB_PSQL 2>&1); then
        rm -f "$STUB_DIR/tx/$id.sql"
        err BadRequestException CommitTransaction "$res"
      fi
    fi
    rm -f "$STUB_DIR/tx/$id.sql"
    echo "{\"transactionStatus\": \"Transaction ${op/commit/Committed}\"}" | sed 's/Transaction rollback/Rollback Complete/'
    exit 0 ;;

  "rds-data execute-statement")
    input=$(from_file "$(arg --cli-input-json "$@")") || exit 255
    sql=$(jq -r .sql <<<"$input")
    txid=$(jq -r '.transactionId // empty' <<<"$input")
    as_json=$(jq -r 'select(.formatRecordsAs == "JSON") | "yes"' <<<"$input")
    jq -r '[.database, .resourceArn, .secretArn, (.sql | gsub("\\s+"; " "))] | @tsv' <<<"$input" >>"$STUB_DIR/rds"
    n=$(($(cat "$STUB_DIR/rds_count" 2>/dev/null || echo 0) + 1)); echo "$n" >"$STUB_DIR/rds_count"
    case "$mode" in
      resume-twice) [ "$n" -le 2 ] && err DatabaseResumingException ExecuteStatement "The Aurora DB instance db-x is resuming after being auto-paused." ;;
      throttle-once) [ "$n" -le 1 ] && err ThrottlingException ExecuteStatement "(reached max retries: 2): Rate exceeded" ;;
      always-resume) err DatabaseResumingException ExecuteStatement "resuming" ;;
      bad-request) err BadRequestException ExecuteStatement "ERROR: syntax error" ;;
      # Postgres echoes the failing statement; with the role statement that includes the password.
      bad-request-echo) err BadRequestException ExecuteStatement "ERROR: syntax error in statement: $sql" ;;
    esac
    if [ -n "$txid" ]; then
      [ -f "$STUB_DIR/tx/$txid.sql" ] || err BadRequestException ExecuteStatement "Transaction $txid is not found"
      if [ "$mode" = no-set-role ] && grep -Eiq '^[[:space:]]*SET[[:space:]]+(LOCAL[[:space:]]+)?ROLE[[:space:]]' <<<"$sql"; then
        echo '{"numberOfRecordsUpdated": 0}'
        exit 0
      fi
    fi
    query=$sql
    if [ -n "$as_json" ]; then query="SELECT coalesce(jsonb_agg(t), '[]'::jsonb)::text FROM (${sql%;}) t"; fi
    records='[]'
    if [ -n "${STUB_PSQL:-}" ] && { [ -z "$txid" ] || [ -n "$as_json" ] || [ "${STUB_TX_CHECK:-each}" != commit ]; }; then
      if [ -n "$txid" ]; then
        script=$({ echo "BEGIN;"; cat "$STUB_DIR/tx/$txid.sql"; printf '%s;\n' "$query"; echo "ROLLBACK;"; })
      else
        script=$(printf '%s\n' "$query")
      fi
      if ! res=$(printf '%s\n' "$script" | $STUB_PSQL -tA 2>&1); then
        err BadRequestException ExecuteStatement "$res"
      fi
      if [ -n "$as_json" ]; then records=$(grep -v '^$' <<<"$res" | tail -1); fi
    fi
    if [ -n "$txid" ]; then printf '%s;\n' "$sql" >>"$STUB_DIR/tx/$txid.sql"; fi
    if [ -n "$as_json" ]; then
      jq -cn --arg r "$records" '{formattedRecords: $r, numberOfRecordsUpdated: 0}'
    else
      echo '{"numberOfRecordsUpdated": 0}'
    fi
    exit 0 ;;
esac
echo "stub: unexpected call: $*" >&2
exit 255
