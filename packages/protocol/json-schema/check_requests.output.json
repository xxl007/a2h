{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "pattern": "^A2H-[0-9a-f]{4}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "sent",
              "accepted",
              "answered",
              "declined",
              "expired",
              "cancelled"
            ]
          },
          "handle": {
            "type": "string",
            "maxLength": 32,
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*-[0-9a-f]{4}$"
          },
          "participant_label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "identity_verified": {
            "type": "boolean"
          },
          "simulated": {
            "type": "boolean"
          },
          "intent": {
            "type": "string",
            "enum": [
              "observation",
              "verification",
              "judgment",
              "opinion",
              "estimate",
              "knowledge",
              "authorisation",
              "action",
              "referral"
            ]
          },
          "transitions": {
            "type": "object",
            "properties": {
              "sent_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "accepted_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "answered_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "declined_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "expired_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "cancelled_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              }
            },
            "required": [
              "sent_at"
            ],
            "additionalProperties": false
          },
          "held_minor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "hold_status": {
            "type": "string",
            "enum": [
              "held",
              "released",
              "captured",
              "none"
            ]
          },
          "cleared_minor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "answer": {
            "type": "object",
            "properties": {
              "request_id": {
                "type": "string",
                "pattern": "^A2H-[0-9a-f]{4}$"
              },
              "participant_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              "confidence": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "answered_personally": {
                "type": "boolean",
                "const": true
              },
              "signed_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "body": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "value": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 10000
                      },
                      "observed_at": {
                        "type": "string",
                        "format": "date-time",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                      },
                      "place": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                      }
                    },
                    "required": [
                      "value",
                      "observed_at",
                      "place"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "verdict": {
                        "type": "string",
                        "enum": [
                          "confirm",
                          "deny",
                          "cant_tell"
                        ]
                      },
                      "evidence": {
                        "anyOf": [
                          {
                            "minItems": 1,
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "ref": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 64,
                                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                                },
                                "media_type": {
                                  "type": "string",
                                  "pattern": "^[a-z]+\\/[a-z0-9.+-]+$"
                                },
                                "size_bytes": {
                                  "type": "integer",
                                  "minimum": 1,
                                  "maximum": 26214400
                                }
                              },
                              "required": [
                                "ref",
                                "media_type",
                                "size_bytes"
                              ],
                              "additionalProperties": false
                            }
                          },
                          {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 10000
                          }
                        ]
                      }
                    },
                    "required": [
                      "verdict"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "verdict": {
                        "type": "string",
                        "enum": [
                          "yes",
                          "no",
                          "cant_tell"
                        ]
                      },
                      "note": {
                        "type": "object",
                        "properties": {
                          "text": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 10000
                          },
                          "voice": {
                            "type": "object",
                            "properties": {
                              "audio_ref": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 64,
                                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                              },
                              "transcript": {
                                "type": "string",
                                "maxLength": 10000
                              },
                              "transcript_edited": {
                                "type": "boolean"
                              }
                            },
                            "required": [
                              "audio_ref",
                              "transcript",
                              "transcript_edited"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "verdict"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "choice": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 32
                          }
                        },
                        "required": [
                          "choice"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "scale": {
                            "type": "number"
                          }
                        },
                        "required": [
                          "scale"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "estimate": {
                        "type": "number"
                      },
                      "range": {
                        "type": "object",
                        "properties": {
                          "low": {
                            "type": "number"
                          },
                          "high": {
                            "type": "number"
                          }
                        },
                        "required": [
                          "low",
                          "high"
                        ],
                        "additionalProperties": false
                      },
                      "unit": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40
                      }
                    },
                    "required": [
                      "estimate",
                      "range"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 10000
                      },
                      "voice": {
                        "type": "object",
                        "properties": {
                          "audio_ref": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 64,
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                          },
                          "transcript": {
                            "type": "string",
                            "maxLength": 10000
                          },
                          "transcript_edited": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "audio_ref",
                          "transcript",
                          "transcript_edited"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "decision": {
                        "type": "string",
                        "enum": [
                          "approve",
                          "reject",
                          "edit"
                        ]
                      },
                      "edit": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 10000
                      }
                    },
                    "required": [
                      "decision"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "artifacts": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "ref": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 64,
                              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                            },
                            "media_type": {
                              "type": "string",
                              "pattern": "^[a-z]+\\/[a-z0-9.+-]+$"
                            },
                            "size_bytes": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 26214400
                            }
                          },
                          "required": [
                            "ref",
                            "media_type",
                            "size_bytes"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "artifacts"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "forwarded_to": {
                        "anyOf": [
                          {
                            "minItems": 1,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "maxLength": 32,
                              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*-[0-9a-f]{4}$"
                            }
                          },
                          {
                            "type": "string",
                            "const": "none"
                          }
                        ]
                      },
                      "note": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 10000
                      }
                    },
                    "required": [
                      "forwarded_to"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "key_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              "signature": {
                "type": "string",
                "pattern": "^[A-Za-z0-9+/]{86}==$"
              }
            },
            "required": [
              "request_id",
              "participant_id",
              "confidence",
              "answered_personally",
              "signed_at",
              "body",
              "key_id",
              "signature"
            ],
            "additionalProperties": false
          },
          "answer_display": {
            "type": "object",
            "properties": {
              "signature": {
                "type": "string",
                "pattern": "^a2h:sig:….{4}$"
              },
              "citation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "verification_notice": {
                "type": "string",
                "maxLength": 200
              }
            },
            "required": [
              "signature",
              "citation"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "request_id",
          "status",
          "handle",
          "simulated",
          "intent",
          "transitions",
          "held_minor",
          "hold_status",
          "currency"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "requests"
  ],
  "additionalProperties": false
}
