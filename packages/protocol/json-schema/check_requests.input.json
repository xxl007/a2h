{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "request_id": {
      "description": "One request, e.g. A2H-7f3c. Omit to list with a filter.",
      "type": "string",
      "pattern": "^A2H-[0-9a-f]{4}$"
    },
    "status": {
      "description": "Filter: only requests in this status.",
      "type": "string",
      "enum": [
        "sent",
        "accepted",
        "answered",
        "declined",
        "expired",
        "cancelled"
      ]
    },
    "since": {
      "description": "Filter: only requests sent at or after this time.",
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "limit": {
      "description": "Filter: at most this many requests, newest first.",
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "additionalProperties": false
}
