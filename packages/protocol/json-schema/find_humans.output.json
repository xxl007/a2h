{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "handle": {
            "type": "string",
            "maxLength": 32,
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*-[0-9a-f]{4}$"
          },
          "simulated": {
            "type": "boolean"
          },
          "topics": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "topic": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "evidence": {
                  "type": "string",
                  "enum": [
                    "self_declared",
                    "job_title",
                    "posts",
                    "licence"
                  ]
                }
              },
              "required": [
                "topic",
                "evidence"
              ],
              "additionalProperties": false
            }
          },
          "rating": {
            "type": "object",
            "properties": {
              "rating": {
                "type": "number",
                "minimum": 0,
                "maximum": 5
              },
              "answers": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "disputes_lost": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "typical_latency_seconds": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "rating",
              "answers",
              "disputes_lost",
              "typical_latency_seconds"
            ],
            "additionalProperties": false
          },
          "ranking_display": {
            "type": "string"
          },
          "latency_promise_seconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "reserves": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "request_type": {
                  "type": "string",
                  "enum": [
                    "observation",
                    "verification",
                    "judgment",
                    "opinion",
                    "estimate",
                    "knowledge",
                    "authorisation",
                    "action",
                    "referral"
                  ]
                },
                "reserve_gross_minor": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "currency": {
                  "type": "string",
                  "pattern": "^[A-Z]{3}$"
                }
              },
              "required": [
                "request_type",
                "reserve_gross_minor",
                "currency"
              ],
              "additionalProperties": false
            }
          },
          "free_lanes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "own_publications",
                "facts_about_self"
              ]
            }
          },
          "identity_verified": {
            "type": "boolean"
          }
        },
        "required": [
          "handle",
          "simulated",
          "topics",
          "rating",
          "ranking_display",
          "latency_promise_seconds",
          "reserves",
          "free_lanes",
          "identity_verified"
        ],
        "additionalProperties": false
      }
    },
    "fee_percent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "hint": {
      "type": "string",
      "maxLength": 300
    }
  },
  "required": [
    "results",
    "fee_percent"
  ],
  "additionalProperties": false
}
