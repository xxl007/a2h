{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "enum": [
        "schema_invalid",
        "principal_not_accountable",
        "principal_not_verified_for_lane",
        "forbidden_content",
        "outside_participant_rules",
        "over_budget",
        "over_cap",
        "approval_required",
        "rate_limited",
        "not_found",
        "invalid_transition",
        "conflict",
        "answer_unverified",
        "unauthorized"
      ]
    },
    "stage": {
      "type": "string",
      "enum": [
        "schema",
        "principal",
        "content",
        "rules",
        "budget",
        "throttle",
        "lifecycle"
      ]
    },
    "retryable": {
      "type": "boolean"
    },
    "request_id": {
      "type": "string",
      "pattern": "^A2H-[0-9a-f]{4}$"
    },
    "detail": {
      "type": "string",
      "maxLength": 200
    },
    "details": {
      "type": "object",
      "properties": {
        "retry_after_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      },
      "required": [
        "retry_after_seconds"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "code",
    "stage",
    "retryable"
  ],
  "additionalProperties": false
}
