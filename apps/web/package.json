{
  "name": "@a2h/web",
  "version": "0.0.0",
  "private": true,
  "description": "Next.js (App Router). Participant PWA + principal dashboard.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm --filter \"@a2h/web^...\" run build && next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern next-env.d.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "auth:schema": "node scripts/auth-schema.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@a2h/db": "workspace:*",
    "@a2h/email": "workspace:*",
    "@a2h/protocol": "workspace:*",
    "@a2h/ui": "workspace:*",
    "@aws-sdk/client-rds-data": "3.1160.0",
    "@aws-sdk/client-s3": "3.1160.0",
    "@aws-sdk/client-sesv2": "3.1160.0",
    "@aws-sdk/client-ssm": "3.1160.0",
    "@better-auth/cimd": "1.7.14",
    "@better-auth/mcp": "1.7.14",
    "@better-auth/oauth-provider": "1.7.14",
    "better-auth": "1.7.14",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.14",
    "next": "15.5.28",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "^5.9.3",
    "vitest": "5.0.5"
  }
}
