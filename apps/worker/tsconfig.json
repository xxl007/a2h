{
  // Typecheck config (editor, ESLint, `pnpm typecheck`): src and test, no emit.
  // `build` uses tsconfig.build.json, which emits src only.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src", "test"]
}
