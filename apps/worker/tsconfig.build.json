{
  // Emit config for `build` and the Dockerfile: src and infra (the deployment
  // adapter), into dist/src and dist/infra.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": ["src", "infra"]
}
