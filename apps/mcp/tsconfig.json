{
  // Typecheck config (editor, ESLint, `pnpm typecheck`): src, infra and test, no emit.
  // `build` uses tsconfig.build.json, which emits src and infra.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // Sources and tests import siblings as `./x.ts` so that `node --test`
    // (type stripping) and infra/ can load them; tsc rewrites to `./x.js` on
    // emit (see tsconfig.build.json).
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src", "infra", "test"]
}
